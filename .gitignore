# Dependencies and build output
node_modules/
dist/
target/
.anchor/
test-ledger/
*.tsbuildinfo

# The local sandbox: validator ledger, logs, screenshots taken by tools
.sandbox/

# Keys and secrets. Never committed, never logged, never echoed.
keys/
*-keypair.json
id.json
.env
.env.*
!.env.example

# Obsidian: the vault's shared settings are committed; each person's state is not.
# Community plugins are never vendored (design/ADR-007-knowledge-vault.md).
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.obsidian/themes/
.obsidian/community-plugins.json
.trash/

# The human's private intake drop stays on this disk. It was removed from git and its history on
# 2026-10-12, before the repository went public.
Docs-Dashy-Drop/

# Confidential notes stay on this disk: only the folder's README is tracked.
kb/private/*
!kb/private/README.md

# Machine noise
.DS_Store
*.log
__pycache__/
