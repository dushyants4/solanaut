# Solanaut's command rules for Codex: tier T4 and the Solana CLI's global config, refused outright.
# Prefix rules see only how a command starts, so they back up AGENTS.md; they do not replace it.
# Check a change with: codex execpolicy check --rules .codex/rules/solanaut.rules <command…>

prefix_rule(pattern=["npm", "publish"], decision="forbidden", justification="Publishing a package is tier T4: the human's, every time (AGENTS.md).")
prefix_rule(pattern=["npm", "unpublish"], decision="forbidden", justification="Tier T4: the human's.")
prefix_rule(pattern=["npm", "deprecate"], decision="forbidden", justification="Tier T4: the human's.")
prefix_rule(pattern=["gh", "repo", ["edit", "create", "delete", "rename", "archive"]], decision="forbidden", justification="The repository's visibility and existence are tier T4: the human's.")
prefix_rule(pattern=["gh", "release"], decision="forbidden", justification="A release is tier T4: the human's.")
prefix_rule(pattern=["gh", "gist"], decision="forbidden", justification="Posting anywhere is tier T4: the human's.")
prefix_rule(pattern=["git", "push", ["--force", "-f", "--force-with-lease", "--mirror", "--delete", "-d"]], decision="forbidden", justification="History on origin is never rewritten or deleted by an agent.")
prefix_rule(pattern=["git", "remote", ["add", "set-url", "remove", "rename"]], decision="forbidden", justification="origin is the private remote; the human changes remotes.")
prefix_rule(pattern=["solana", "config"], decision="forbidden", justification="Never touch the Solana CLI's global config; pass --url and --keypair explicitly.")
prefix_rule(pattern=["node", "tools/colosseum_entry.mjs"], decision="forbidden", justification="The Colosseum submission is tier T4, set aside by the human until testing is done.")

# The machine-wide rules allow these unrestricted, for other projects. Here, gh api could change the repository's
# settings or visibility (T4), and this machine's ssh hosts belong to other projects. A forbidden rule outranks an allow.
prefix_rule(pattern=["gh", "api"], decision="forbidden", justification="gh api can change the repository's settings or visibility (tier T4); read CI with gh run list and gh run view.")
prefix_rule(pattern=["ssh"], decision="forbidden", justification="Solanaut has no servers; this machine's ssh hosts belong to other projects (AGENTS.md, isolation).")
prefix_rule(pattern=["scp"], decision="forbidden", justification="Solanaut has no servers; this machine's ssh hosts belong to other projects (AGENTS.md, isolation).")
